# For this project, I downloaded Spotify data from Kaggle
# Then I created a table to insert Spotify data into.
# Finally, I performed analytics on the data using SQL. 

#Creating the table: 
CREATE TABLE BIT_DB.Spotifydata (
id integer PRIMARY KEY,
artist_name varchar NOT NULL,
track_name varchar NOT NULL,
track_id varchar NOT NULL,
popularity integer NOT NULL,
danceability decimal(4,3) NOT NULL,
energy decimal(4,3) NOT NULL,
key integer NOT NULL,
loudness decimal(5,3) NOT NULL,
mode integer NOT NULL,
speechiness decimal(5,4) NOT NULL,
acousticness decimal(6,5) NOT NULL,
instrumentalness text NOT NULL,
liveness decimal(5,4) NOT NULL,
valence decimal(4,3) NOT NULL,
tempo decimal(6,3) NOT NULL,
duration_ms integer NOT NULL,
time_signature integer NOT NULL 
)

#Then I inserted the Spotify Data .csv into the table.

#Next, I explored the data using the following SQL. 

-- What are the top 10 most popular tracks based on the popularity score?

SELECT track_name, popularity
FROM Spotifydata
ORDER BY Popularity desc
LIMIT 10;

-- Which tracks have a tempo between 120 and 130 BPM?

SELECT track_name, ROUND(tempo) AS BPM
FROM Spotifydata
WHERE tempo BETWEEN 120 AND 130
ORDER BY tempo desc;

-- What is the total duration of all tracks combined in hours, minutes and seconds?

SELECT (SUM(duration_ms) / 1000) / 3600 AS hours,
((SUM(duration_ms) / 1000) % 3600) / 60 AS minutes,
(SUM(duration_ms) / 1000) % 60 AS seconds
FROM Spotifydata;

-- Which tracks have an energy level greater than 0.7 and a danceability score above 0.8?

SELECT track_name, energy, danceability
FROM Spotifydata
WHERE energy > 0.7
AND danceability > 0.8
ORDER BY energy;

-- Which tracks have a duration longer than the average track length?

SELECT track_name, duration_ms
FROM Spotifydata
WHERE duration_ms > (SELECT AVG(duration_ms) FROM Spotifydata)
ORDER BY duration_ms desc;

-- Which artists have more than 3 tracks in the dataset?

SELECT artist_name, COUNT(track_name) AS number_of_tracks
FROM Spotifydata
GROUP BY artist_name
HAVING number_of_tracks > 3
ORDER BY number_of_tracks;

-- Create a classification that labels tracks as "High Energy" if the energy is above 0.7, "Medium Energy" 
-- if between 0.4 and 0.7, and "Low Energy" otherwise.

SELECT track_name, energy,
CASE
    WHEN energy > 0.7 THEN 'High energy'
    WHEN energy BETWEEN 0.4 AND 0.7 THEN 'Medium energy'
    ELSE 'Low energy'
END AS energy_level
FROM Spotifydata
ORDER BY energy desc;

-- Which artist has the highest liveness with an energy level of 0.7 or higher?

SELECT artist_name, MAX(liveness) AS max_liveness, energy
FROM Spotifydata
WHERE energy >= 0.7
GROUP BY artist_name
ORDER BY MAX(liveness) desc
LIMIT 1;

-- What is the total number of tracks for each artist?

SELECT artist_name AS "Artist name", COUNT(track_name) AS "Number of tracks per artist"
FROM Spotifydata
GROUP BY artist_name
ORDER BY COUNT(track_name) desc;

-- Retrieve all artists whose names start with the letter "A".

SELECT artist_name
FROM Spotifydata
WHERE artist_name LIKE 'A%';
