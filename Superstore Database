# I used SQL to query the Superstore database to get information about items sold at the store, how many and the prices

# Order items by price

SELECT *
FROM superstore
ORDER BY price desc;

# What is them maximum price of all the items listed in the table? 

SELECT MAX(price)
FROM superstore;

# What is the sum total of all kitchen supplies purchased?

SELECT SUM(price)'Kitchen Supplies'
FROM superstore;

# What item has the most items in stock and how many?

SELECT item_name, stock_quantity
FROM superstore
ORDER BY stock_quantity DESC
LIMIT 1;

# Write a SQL query that orders the items by price.

SELECT item_name
FROM superstore
ORDER BY price;

# Write your own SQL query that will show a statistic about the item prices, like a sum, average, minimum, maximum, or count.
# What item has the most in stock?

SELECT MAX(stock_quantity), item_name
FROM superstore;

# Write your own SQL query that will show a statistic about the price for items in the category of "Kitchen Supplies".

SELECT item_name, category, price
FROM superstore
WHERE category = "Furnishings"
ORDER BY price desc;

# What is the average rating for electronics sold?

SELECT item_name, category, average_rating
FROM superstore
WHERE category = "Electronics";

# Write a SQL query that orders the items by price.

SELECT *
FROM superstore
ORDER BY price;

# Write your own SQL query that will show a statistic about the item prices, like a sum, average, minimum, maximum, or count.

SELECT category, item_name, MAX(price)
FROM superstore
GROUP BY category
ORDER BY MAX(price) desc;

# Write your own SQL query that will show a statistic about the price for items in the category of "Kitchen Supplies".

SELECT category, item_name, MIN(price)
FROM superstore
WHERE category = 'Kitchen Supplies';

# How many Memory Foam Mattress' are there?

SELECT item_name, COUNT(stock_quantity)
FROM superstore
WHERE item_name = 'Memory Foam Mattress'
GROUP BY item_name;
